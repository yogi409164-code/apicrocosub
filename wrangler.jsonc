{
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/index.ts",
	"name": "apicrocosub",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public"
	},
	// Production `npm run deploy` creates Hyperdrive (DigitalOcean TLS) and writes the real id.
	// Local `npm run api` injects Hyperdrive via scripts/dev.mjs.
	// POSTGRES_PASSWORD is hardcoded in src/croco/source.ts.
	// Other secrets live in .dev.vars for local runs and in `wrangler secret` for deploys.
	"vars": {
		"APP_NAME": "Crocosip API",
		"POSTGRES_HOST": "dbaas-db-1025064-do-user-46253107-0.e.db.ondigitalocean.com",
		"POSTGRES_PORT": "25060",
		"POSTGRES_USER": "doadmin",
		"POSTGRES_DB": "defaultdb",
		"POSTGRES_SSLMODE": "require",
		"DB_SCHEMA": "Crocosip_mobile_app",
		"ACCESS_TOKEN_EXPIRE_MINUTES": "10080",
		"GOOGLE_WEB_CLIENT_ID": "1028343714410-l4nab6f0io43tr73svdnd3i67lp5fk8g.apps.googleusercontent.com",
		"GOOGLE_BROWSER_CLIENT_ID": "1028343714410-g6fg3lop4r0kte460sgnu3lq8h7gd1r1.apps.googleusercontent.com",
		"GOOGLE_ANDROID_CLIENT_ID": "1028343714410-bravnjrjce1u6pt8jlrom7320qgdtqgd.apps.googleusercontent.com"
	}
}
